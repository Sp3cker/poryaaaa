diff --git a/src/detail/vst3/process.cpp b/src/detail/vst3/process.cpp
index 64b382d..79437d9 100644
--- a/src/detail/vst3/process.cpp
+++ b/src/detail/vst3/process.cpp
@@ -685,6 +685,64 @@ void ProcessAdapter::processInputEvents(Steinberg::Vst::IEventList* eventlist)
             }
           }
         }
+        if (vstevent.type == Vst::Event::kLegacyMIDICCOutEvent)
+        {
+          clap_multi_event_t n;
+          n.param.header.type = CLAP_EVENT_MIDI;
+          n.param.header.flags = (vstevent.flags & Vst::Event::kIsLive) ? CLAP_EVENT_IS_LIVE : 0;
+          n.param.header.space_id = CLAP_CORE_EVENT_SPACE_ID;
+          n.param.header.time = vstevent.sampleOffset;
+          n.param.header.size = sizeof(clap_event_midi_t);
+          n.midi.port_index = 0;
+
+          const uint8_t ch = static_cast<uint8_t>(vstevent.midiCCOut.channel & 0x0F);
+          const uint8_t ctrl = vstevent.midiCCOut.controlNumber;
+          const uint8_t v1 = static_cast<uint8_t>(vstevent.midiCCOut.value) & 0x7F;
+          const uint8_t v2 = static_cast<uint8_t>(vstevent.midiCCOut.value2) & 0x7F;
+
+          bool emit = true;
+          switch (ctrl)
+          {
+            case Vst::ControllerNumbers::kAfterTouch:  // channel pressure
+              n.midi.data[0] = 0xD0 | ch;
+              n.midi.data[1] = v1;
+              n.midi.data[2] = 0;
+              break;
+            case Vst::ControllerNumbers::kPitchBend:
+              n.midi.data[0] = 0xE0 | ch;
+              n.midi.data[1] = v1;  // LSB
+              n.midi.data[2] = v2;  // MSB
+              break;
+            case Vst::ControllerNumbers::kCtrlProgramChange:
+              n.midi.data[0] = 0xC0 | ch;
+              n.midi.data[1] = v1;
+              n.midi.data[2] = 0;
+              break;
+            case Vst::ControllerNumbers::kCtrlPolyPressure:
+              n.midi.data[0] = 0xA0 | ch;
+              n.midi.data[1] = v1;  // pitch
+              n.midi.data[2] = v2;  // pressure
+              break;
+            default:
+              if (ctrl < 128)  // regular CC 0-127
+              {
+                n.midi.data[0] = 0xB0 | ch;
+                n.midi.data[1] = ctrl;
+                n.midi.data[2] = v1;
+              }
+              else
+              {
+                emit = false;  // unknown extended controller
+              }
+              break;
+          }
+
+          if (emit)
+          {
+            _eventindices.push_back(_events.size());
+            _events.push_back(n);
+          }
+        }
       }
     }
   }
